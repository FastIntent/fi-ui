{
  "name": "atomize-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Atomize UI monorepo — atomic, composable, themeable React components for Next.js App Router",
  "homepage": "https://atomizeui.com",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:styles": "turbo run lint:styles",
    "validate": "turbo run validate",
    "token-audit": "turbo run token-audit",
    "size-check": "turbo run size-check",
    "size-baseline": "turbo run size-baseline -- --update-baseline",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "chromatic": "turbo run chromatic",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,scss,css,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,scss,css,json,md}\" --ignore-path .gitignore",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=\"./packages/*\" && changeset publish",
    "verify": "pnpm run typecheck && pnpm run validate && pnpm run token-audit && pnpm run test && pnpm run build && pnpm run size-check && pnpm run build-storybook",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "turbo": "^2.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{scss,css}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  }
}
