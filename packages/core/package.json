{
  "name": "@atomizeui/core",
  "version": "2.1.5",
  "type": "module",
  "description": "Atomize UI — enterprise-class React component library for the Next.js App Router. Atomic, composable, themeable.",
  "homepage": "https://atomizeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomizeui/atomize-ui.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./design-system": {
      "types": "./dist/design-system.d.ts",
      "import": "./dist/design-system.js",
      "require": "./dist/design-system.cjs"
    },
    "./design-system.css": "./dist/design-system.css",
    "./base.css": "./dist/styles/base.css",
    "./global": {
      "types": "./dist/styles/global.d.ts",
      "import": "./dist/styles/global.js",
      "require": "./dist/styles/global.cjs"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.cjs"
    },
    "./components/*/index.css": "./dist/components/*/index.css",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "size-check": "node scripts/bundle-size-check.mjs && node scripts/treeshake-check.mjs",
    "size-baseline": "node scripts/bundle-size-check.mjs --update-baseline",
    "chromatic": "chromatic --config-file chromatic.config.json",
    "validate": "node scripts/validate-components.mjs",
    "token-audit": "node scripts/token-audit.mjs",
    "token-audit:ci": "node scripts/token-audit.mjs --strict --json",
    "lint:styles": "stylelint \"src/components/**/*.scss\"",
    "lint:styles:fix": "stylelint \"src/components/**/*.scss\" --fix",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "components",
    "nextjs",
    "atomic-design",
    "tailwind-alternative",
    "tokens",
    "themeable"
  ],
  "author": "Atomize UI",
  "license": "MIT",
  "peerDependencies": {
    "dayjs": ">=1.11.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-easy-crop": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    },
    "react-easy-crop": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rc-component/checkbox": "^1.0.1",
    "@rc-component/collapse": "^1.2.0",
    "@rc-component/dialog": "^1.9.0",
    "@rc-component/drawer": "^1.4.2",
    "@rc-component/dropdown": "^1.0.2",
    "@rc-component/form": "^1.7.2",
    "@rc-component/input": "^1.2.1",
    "@rc-component/input-number": "^1.6.2",
    "@rc-component/menu": "^1.2.0",
    "@rc-component/pagination": "^1.2.0",
    "@rc-component/picker": "^1.9.1",
    "@rc-component/progress": "^1.0.2",
    "@rc-component/rate": "^1.0.1",
    "@rc-component/select": "^1.6.15",
    "@rc-component/slider": "^1.0.1",
    "@rc-component/switch": "^1.0.3",
    "@rc-component/table": "^1.10.0",
    "@rc-component/tabs": "^1.9.0",
    "@rc-component/tooltip": "^1.4.0",
    "@rc-component/upload": "^1.1.0",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "css-loader": "^7.1.2",
    "esbuild": "^0.25.0",
    "mini-css-extract-plugin": "^2.9.2",
    "rollup": "^4.30.0",
    "webpack": "^5.97.1",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.1",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.3.0",
    "happy-dom": "^20.9.0",
    "jest-axe": "^10.0.0",
    "postcss-scss": "^4.0.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "sass": "^1.98.0",
    "storybook": "8.6.18",
    "stylelint": "^17.11.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-scss": "^7.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
